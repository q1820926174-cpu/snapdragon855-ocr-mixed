+// Opt-in compatibility path for the SCV41 numeric regression reproducer.
+// Keep device execution, weight storage and arithmetic precision unchanged.
+static Option scv41_gemm_safe_options(const Option& original) {
+    Option safe=original;
+    if (std::getenv("SCV41_NCNN_SAFE_GEMM")) {
+        const bool fp32_slm64=std::getenv("SCV41_NCNN_FP32_SLM64") && !original.use_fp16_packed && !original.use_fp16_storage && !original.use_fp16_arithmetic && !original.use_bf16_storage && !original.use_bf16_packed;
+        safe.use_shader_local_memory=fp32_slm64;
+        safe.use_subgroup_ops=false;
+    }
+    return safe;
+}
